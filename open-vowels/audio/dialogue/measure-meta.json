  {
   "id": "tc-7ab2ee8e",
   "sp": "tc",
   "text": "Dad said he was sad.",
   "kind": "other"
  },
  {
   "id": "tc-d4a29386",
   "sp": "tc",
   "text": "Is your pet a cat?",
   "kind": "other"
  },
  {
   "id": "tc-7e4bbd23",
   "sp": "tc",
   "text": "I bet you can't guess.",
   "kind": "other"
  },
  {
   "id": "tc-1dc5b6ae",
   "sp": "tc",
   "text": "Pack your bag and get ready.",
   "kind": "other"
  },
  {
   "id": "tc-ddc17423",
   "sp": "tc",
   "text": "The gas tank is empty.",
   "kind": "other"
  },
  {
   "id": "tc-fb5d51be",
   "sp": "tc",
   "text": "Good luck with the lock.",
   "kind": "other"
  },
  {
   "id": "tc-abed59ce",
   "sp": "tc",
   "text": "Shut the box.",
   "kind": "other"
  },
  {
   "id": "tc-e81a7759",
   "sp": "tc",
   "text": "The duck is on the dock.",
   "kind": "other"
  },
  {
   "id": "tc-44a9dfd7",
   "sp": "tc",
   "text": "My mother is a doctor.",
   "kind": "other"
  },
  {
   "id": "tc-5295fc02",
   "sp": "tc",
   "text": "What color is the collar?",
   "kind": "other"
  },
  {
   "id": "tc-6fd4b620",
   "sp": "tc",
   "text": "Come on, it's not fun.",
   "kind": "other"
  },
  {
   "id": "tc-5a71d205",
   "sp": "tc",
   "text": "I'd like an apple and a banana.",
   "kind": "other"
  },
  {
   "id": "tc-93173011",
   "sp": "tc",
   "text": "Take a taxi to the doctor.",
   "kind": "other"
  },
  {
   "id": "tc-e1523e21",
   "sp": "tc",
   "text": "My camera is on the bus.",
   "kind": "other"
  },
  {
   "id": "tc-1238a65b",
   "sp": "tc",
   "text": "Check the menu for chocolate.",
   "kind": "other"
  },
  {
   "id": "tc-0e74f163",
   "sp": "tc",
   "text": "The doctor gave me a lemon.",
   "kind": "other"
  },
  {
   "id": "tc-20633161",
   "sp": "tc",
   "text": "We went shopping for a dress.",
   "kind": "other"
  },
  {
   "id": "tc-7ffee373",
   "sp": "tc",
   "text": "My mother has money for the bus.",
   "kind": "other"
  },
  {
   "id": "tc-1ef792c9",
   "sp": "tc",
   "text": "That fat cat is not much fun.",
   "kind": "other"
  },
  {
   "id": "tc-2b8e72f8",
   "sp": "tc",
   "text": "Get the cup from the shop.",
   "kind": "other"
  },
  {
   "id": "tc-99f68b86",
   "sp": "tc",
   "text": "Stop and check the map.",
   "kind": "other"
  },
  {
   "id": "tc-3effaee0",
   "sp": "tc",
   "text": "The sun is hot and red.",
   "kind": "other"
  },
  {
   "id": "tc-cf172355",
   "sp": "tc",
   "text": "My son got a black hat.",
   "kind": "other"
  },
  {
   "id": "tc-08c6f0da",
   "sp": "tc",
   "text": "Mom sent a lot of love.",
   "kind": "other"
  },
