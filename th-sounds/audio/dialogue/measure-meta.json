  {
   "id": "tc-b477b3ef",
   "sp": "tc",
   "text": "I think so.",
   "kind": "other"
  },
  {
   "id": "tc-98e03b6f",
   "sp": "tc",
   "text": "Three tickets, please.",
   "kind": "other"
  },
  {
   "id": "tc-c32376d5",
   "sp": "tc",
   "text": "See you on Thursday.",
   "kind": "other"
  },
  {
   "id": "tc-8227e583",
   "sp": "tc",
   "text": "I have a sore throat.",
   "kind": "other"
  },
  {
   "id": "tc-a7aac7e1",
   "sp": "tc",
   "text": "Let me think about it.",
   "kind": "other"
  },
  {
   "id": "tc-f5e54b04",
   "sp": "tc",
   "text": "It costs thirty dollars.",
   "kind": "other"
  },
  {
   "id": "tc-51276832",
   "sp": "tc",
   "text": "What's that?",
   "kind": "other"
  },
  {
   "id": "tc-4061fd0e",
   "sp": "tc",
   "text": "They live over there.",
   "kind": "other"
  },
  {
   "id": "tc-cd1919fc",
   "sp": "tc",
   "text": "Is this the right bus?",
   "kind": "other"
  },
  {
   "id": "tc-7c109f8f",
   "sp": "tc",
   "text": "How's the weather today?",
   "kind": "other"
  },
  {
   "id": "tc-0b6eced8",
   "sp": "tc",
   "text": "I'll take these, please.",
   "kind": "other"
  },
  {
   "id": "tc-3cb7394f",
   "sp": "tc",
   "text": "My mother and father are teachers.",
   "kind": "other"
  },
  {
   "id": "tc-dd15fe9d",
   "sp": "tc",
   "text": "Brush your teeth.",
   "kind": "other"
  },
  {
   "id": "tc-5f233d50",
   "sp": "tc",
   "text": "Open your mouth, please.",
   "kind": "other"
  },
  {
   "id": "tc-dc48adb4",
   "sp": "tc",
   "text": "Come with me.",
   "kind": "other"
  },
  {
   "id": "tc-89fc0c9e",
   "sp": "tc",
   "text": "It's worth it.",
   "kind": "other"
  },
  {
   "id": "tc-5877edc7",
   "sp": "tc",
   "text": "Both are fine.",
   "kind": "other"
  },
  {
   "id": "tc-c6624eb2",
   "sp": "tc",
   "text": "Happy birthday!",
   "kind": "other"
  },
  {
   "id": "tc-6f9ca459",
   "sp": "tc",
   "text": "I thought they were together.",
   "kind": "other"
  },
  {
   "id": "tc-b7b599d2",
   "sp": "tc",
   "text": "Thanks for the birthday gift.",
   "kind": "other"
  },
  {
   "id": "tc-ee0d98c7",
   "sp": "tc",
   "text": "My brother is thirty years old.",
   "kind": "other"
  },
  {
   "id": "tc-89a2d760",
   "sp": "tc",
   "text": "The math test is on the third.",
   "kind": "other"
  },
  {
   "id": "tc-c7723715",
   "sp": "tc",
   "text": "Is there a bathroom on this floor?",
   "kind": "other"
  },
  {
   "id": "tc-0c610f70",
   "sp": "tc",
   "text": "Nothing is better than this.",
   "kind": "other"
  },
