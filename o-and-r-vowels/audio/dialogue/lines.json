   "id": "tc-c40b9e1a",
   "sp": "tc",
   "text": "I saw a goat.",
   "from": "video"
  },
  {
   "id": "tc-53f38177",
   "sp": "tc",
   "text": "I want a coat.",
   "from": "video"
  },
  {
   "id": "tc-0b6e4174",
   "sp": "tc",
   "text": "We're not going home.",
   "from": "video"
  },
  {
   "id": "tc-c26cad9a",
   "sp": "tc",
   "text": "Hope the cost is low.",
   "from": "video"
  },
  {
   "id": "tc-73783354",
   "sp": "tc",
   "text": "It's cold, so call home.",
   "from": "video"
  },
  {
   "id": "tc-fd3674ae",
   "sp": "tc",
   "text": "The bird is in the sun.",
   "from": "video"
  },
  {
   "id": "tc-f2d65327",
   "sp": "tc",
   "text": "Her son had fun.",
   "from": "video"
  },
  {
   "id": "tc-2798ab80",
   "sp": "tc",
   "text": "Shut the door and turn left.",
   "from": "video"
  },
  {
   "id": "tc-2977828a",
   "sp": "tc",
   "text": "Learn from your mother.",
   "from": "video"
  },
  {
   "id": "tc-35901643",
   "sp": "tc",
   "text": "First, cut the bread.",
   "from": "video"
  },
  {
   "id": "tc-96a9d99f",
   "sp": "tc",
   "text": "The nurse had lunch in a hurry.",
   "from": "video"
  },
  {
   "id": "tc-9fade962",
   "sp": "tc",
   "text": "Turn on the computer.",
   "from": "video"
  },
  {
   "id": "tc-1cca1ae4",
   "sp": "tc",
   "text": "Put the phone on the paper.",
   "from": "video"
  },
  {
   "id": "tc-30727c4f",
   "sp": "tc",
   "text": "Water and toast, please.",
   "from": "video"
  },
  {
   "id": "tc-0cbac9ee",
   "sp": "tc",
   "text": "Let's go to the show.",
   "from": "video"
  },
  {
   "id": "tc-8172f567",
   "sp": "tc",
   "text": "My sister is a teacher.",
   "from": "video"
  },
  {
   "id": "tc-1320e385",
   "sp": "tc",
   "text": "I had a burger at the center.",
   "from": "video"
  },
  {
   "id": "tc-b11113e6",
   "sp": "tc",
   "text": "I don't walk to work.",
   "from": "video"
  },
  {
   "id": "tc-e88281c0",
   "sp": "tc",
   "text": "Her coat is on the bus.",
   "from": "video"
  },
  {
   "id": "tc-6f67662e",
   "sp": "tc",
   "text": "Go home and learn something new.",
   "from": "video"
  },
  {
   "id": "tc-edffb472",
   "sp": "tc",
   "text": "I saw the first show.",
   "from": "video"
  },
  {
   "id": "tc-499ce145",
   "sp": "tc",
   "text": "The water in the cup was cold.",
   "from": "video"
  },
  {
   "id": "tc-66122df6",
   "sp": "tc",
   "text": "Don't touch the hot stove.",
   "from": "video"
  },
  {
