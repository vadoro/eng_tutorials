 "pieces": [
  {
   "id": "kd8cd4316",
   "lang": "ko",
   "text": "관계대명사는 토익 문법 문제에 자주 나오는 단골 손님이에요.",
   "cap": 0
  },
  {
   "id": "k99bb50c7",
   "lang": "ko",
   "text": "예를 들어 이런 문제예요. 빈칸에",
   "cap": 1
  },
  {
   "id": "eaded7ae5",
   "lang": "en",
   "text": "who, whom, whose, what",
   "cap": 1
  },
  {
   "id": "kacdf8df0",
   "lang": "ko",
   "text": "중 무엇이 들어갈까요?",
   "cap": 1
  },
  {
   "id": "kf10ca6d2",
   "lang": "ko",
   "text": "3초 안에 골라 보세요. 감으로 고르면 자꾸 틀려요.",
   "cap": 2
  },
  {
   "id": "k3ece4679",
   "lang": "ko",
   "text": "규칙을 알면 문장을 다 해석하지 않아도 답이 보여요.",
   "cap": 3
  },
  {
   "id": "k5ae7dfd0",
   "lang": "ko",
   "text": "관계대명사가 하는 일, 빈자리 찾기, 그리고 3단계 풀이법을 차례로 배워요.",
   "cap": 4
  },
  {
   "id": "k7a849bf7",
   "lang": "ko",
   "text": "한국어에서는 꾸미는 말이 명사 앞에 와요. 한국 음식을 요리하는 요리사.",
   "cap": 5
  },
  {
   "id": "k35ad46bc",
   "lang": "ko",
   "text": "영어는 반대예요. 긴 꾸밈말은 명사 뒤에 붙어요.",
   "cap": 6
  },
  {
   "id": "e34eb9698",
   "lang": "en",
   "text": "a chef who cooks Korean food.",
   "cap": 6
  },
  {
   "id": "kb600c157",
   "lang": "ko",
   "text": "한 단어로 꾸밀 때는",
   "cap": 7
  },
  {
   "id": "ef316a84e",
   "lang": "en",
   "text": "a busy chef",
   "cap": 7
  },
  {
   "id": "k978650d0",
   "lang": "ko",
   "text": "처럼 앞에 두지만, 문장처럼 길어지면 뒤로 가요.",
   "cap": 7
  },
  {
   "id": "k0eed1566",
   "lang": "ko",
   "text": "그래서 영어는 명사를 먼저 말하고, 뒤에서 설명을 덧붙인다고 생각하면 돼요.",
   "cap": 8
  },
  {
   "id": "k0338d621",
   "lang": "ko",
   "text": "꾸밈을 받는 앞의 명사를 선행사, 뒤에서 꾸미는 문장을 관계사절이라고 해요.",
   "cap": 9
  },
  {
   "id": "k184b09fd",
   "lang": "ko",
   "text": "관계사절의 맨 앞에서 문을 여는 말",
   "cap": 10
  },
  {
   "id": "efa6818de",
   "lang": "en",
   "text": "who",
   "cap": 10
  },
  {
   "id": "keb5c63f2",
   "lang": "ko",
   "text": "가 바로 관계대명사예요.",
   "cap": 10
  },
  {
   "id": "kab107094",
   "lang": "ko",
   "text": "두 문장이 있어요.",
   "cap": 11
  },
  {
   "id": "e56d17a15",
