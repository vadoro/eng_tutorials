   "text": "는 그 회사의라는 뜻이에요. 이 소유격을",
   "cap": 36
  },
  {
   "id": "e7f320b19",
   "lang": "en",
   "text": "company",
   "cap": 36
  },
  {
   "id": "ke29cb3fc",
