   "text": "I know a chef.",
   "cap": 11
  },
  {
   "id": "ecfa1a2d5",
   "lang": "en",
   "text": "She cooks Korean food.",
   "cap": 11
  },
  {
   "id": "ef76156fb",
   "lang": "en",
   "text": "a chef",
   "cap": 12
  },
  {
   "id": "k9f34a81b",
   "lang": "ko",
   "text": "와",
   "cap": 12
  },
  {
   "id": "ec0bcbb3c",
