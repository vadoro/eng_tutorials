   "cap": 51
  },
  {
   "id": "kd8777210",
   "lang": "ko",
   "text": "가족이니 품사 문제예요.",
   "cap": 51
  },
  {
   "id": "ke4a3f7d1",
   "lang": "ko",
   "text": "둘째, 빈칸 앞에",
