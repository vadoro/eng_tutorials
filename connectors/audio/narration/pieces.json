  },
  {
   "id": "e0f6b9405",
   "lang": "en",
   "text": "You can apply either online or by phone.",
   "cap": 29
  },
  {
   "id": "kdad08d73",
   "lang": "ko",
   "text": "거꾸로 빈칸 뒤에",
