   "text": "Let me check. Unfortunately, we're fully booked on the twelfth. There's a medical convention in town that week.",
   "from": "say"
  },
  {
   "id": "e6431be63",
   "lang": "en",
   "text": "A session starts early in the morning.",
   "from": "say"
  },
  {
   "id": "e4b8c0524",
   "lang": "en",
   "text": "A room was booked under the wrong name.",
   "from": "say"
  },
  {
   "id": "ed239b1cf",
   "lang": "en",
   "text": "No rooms are available on one night.",
   "from": "say"
  },
  {
   "id": "ea8a9cd4c",
   "lang": "en",
   "text": "The hotel is closed for repairs.",
   "from": "say"
  },
  {
   "id": "ecfff4ea1",
   "lang": "en",
   "text": "Oh, no. That's the night we need most.",
   "from": "say"
  },
  {
   "id": "e223df5ca",
   "lang": "en",
   "text": "Why is the woman calling?",
